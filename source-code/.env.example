# Example Configuration File for Local Development

# Apify Configuration
APIFY_TOKEN=your_apify_token_here
APIFY_HEADLESS=1
APIFY_LOCAL_STORAGE_DIR=./apify_storage
APIFY_DEFAULT_DATASET_ID=default
APIFY_DEFAULT_KEY_VALUE_STORE_ID=default
APIFY_DEFAULT_REQUEST_QUEUE_ID=default

# Actor Input (for local testing)
# Note: When running on Apify platform, use the INPUT.json file instead
ACTOR_INPUT_MAX_PAGES=3
ACTOR_INPUT_USE_PROXY=true

# Debugging
# Set to DEBUG for verbose logging
LOG_LEVEL=INFO

# Proxy Configuration (if testing locally without Apify Proxy)
# LOCAL_PROXY_URL=http://your-proxy-server:port
